<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#374151" />
      <mj-button background-color="#111827" border-radius="6px" font-size="14px" font-weight="600" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f3f4f6">

    <!-- Header -->
    <mj-section background-color="#111827" padding="24px 0">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="20px" font-weight="700" letter-spacing="1px">
          RockHub2
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Conteúdo -->
    <mj-section background-color="#ffffff" border-radius="8px" padding="40px 32px">
      <mj-column>

        <mj-text font-size="22px" font-weight="700" color="#111827" padding-bottom="8px">
          Nova proposta disponível
        </mj-text>

        <mj-text padding-bottom="24px">
          Olá, {{ client_name }}. Uma proposta foi preparada para você. Confira os detalhes abaixo:
        </mj-text>

        <!-- Resumo da proposta -->
        <mj-table>
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; color: #6b7280; font-size: 13px;">Proposta</td>
            <td style="padding: 10px 0; font-weight: 600; text-align: right;">{{ proposal_title }}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb;">
            <td style="padding: 10px 0; color: #6b7280; font-size: 13px;">Válida até</td>
            <td style="padding: 10px 0; font-weight: 600; text-align: right;">{{ valid_until }}</td>
          </tr>
          <tr>
            <td style="padding: 10px 0; color: #6b7280; font-size: 13px;">Total</td>
            <td style="padding: 10px 0; font-weight: 700; font-size: 18px; color: #111827; text-align: right;">{{ total }}</td>
          </tr>
        </mj-table>

        <mj-spacer height="32px" />

        <mj-button href="{{ proposal_url }}" align="left">
          Ver proposta completa
        </mj-button>

        <mj-spacer height="24px" />

        <mj-text font-size="13px" color="#9ca3af">
          Dúvidas? Responda este email ou entre em contato com {{ contact_name }} em {{ contact_email }}.
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
          © {{ ano }} RockHub2. Todos os direitos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
