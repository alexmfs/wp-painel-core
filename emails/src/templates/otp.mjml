<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#374151" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f3f4f6">

    <!-- Header -->
    <mj-section background-color="#ffffff" padding="32px 0 0">
      <mj-column>
        <mj-image src="{{ site_url }}/logo-bw8.png" alt="{{ site_name }}" width="120px" align="center" />
      </mj-column>
    </mj-section>

    <!-- Saudação -->
    <mj-section background-color="#ffffff" padding="40px 32px 0">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#111827" padding-bottom="8px">
          Seu código de acesso
        </mj-text>
        <mj-text padding-bottom="24px">
          Olá, {{ name }}. Use o código abaixo para entrar no painel:
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Código -->
    <mj-section background-color="#ffffff" padding="0 32px 20px">
      <mj-column background-color="#f9fafb" border-left="4px solid #111827" padding="16px">
        <mj-text font-size="13px" color="#6b7280" padding-bottom="2px">Código de Acesso</mj-text>
        <mj-text font-weight="700" color="#111827" font-size="28px" font-family="'Courier New', monospace" letter-spacing="4px">{{ code }}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Aviso -->
    <mj-section background-color="#ffffff" padding="0 32px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af">
          Válido por 10 minutos. Não compartilhe este código com ninguém.
          Se você não solicitou o acesso, ignore este e-mail.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
          © {{ ano }} {{ site_name }}. Todos os direitos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
