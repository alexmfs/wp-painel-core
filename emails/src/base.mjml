<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#374151" />
      <mj-button background-color="#111827" border-radius="6px" font-size="14px" font-weight="600" />
    </mj-attributes>

    <mj-style>
      .footer-link { color: #9ca3af !important; text-decoration: none; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">

    <!-- Header -->
    <mj-section background-color="#111827" padding="24px 0">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="20px" font-weight="700" letter-spacing="1px">
          RockHub2
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Conteúdo -->
    <mj-section background-color="#ffffff" border-radius="8px" padding="40px 32px" css-class="main-card">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#111827" padding-bottom="8px">
          {{ titulo }}
        </mj-text>
        <mj-text>
          {{ corpo }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
          Você recebeu este email porque está cadastrado no RockHub2.<br />
          <a href="{{ url_descadastro }}" class="footer-link">Cancelar inscrição</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
